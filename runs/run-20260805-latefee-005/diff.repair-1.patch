 from __future__ import annotations

 from loanflow.errors import ValidationError


 def classify_late_fee_tier(days_past_due: int) -> str:
     if days_past_due < 0:
         raise ValidationError("days_past_due must not be negative")
     if days_past_due <= 5:
         return "grace"
     if days_past_due < 30:
         return "standard"
     return "severe"
