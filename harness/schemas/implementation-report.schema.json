{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticharness.local/schemas/implementation-report.schema.json",
  "title": "Implementation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "created_at",
    "scope_ref",
    "status",
    "dependency_changes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "scope_ref": { "$ref": "#/$defs/artifactRef" },
    "findings_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "finding_ids"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "minimal_change_rung": { "type": "integer", "minimum": 1, "maximum": 5 },
    "minimal_change_rationale": { "type": "string", "minLength": 1 },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/changedFile" }
    },
    "diff_ref": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "test_first_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_implementation_command_id", "post_implementation_command_id"],
      "properties": {
        "pre_implementation_command_id": { "type": "string", "minLength": 1 },
        "post_implementation_command_id": { "type": "string", "minLength": 1 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testEntry" }
    },
    "dependency_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependencyChange" }
    },
    "status": { "enum": ["ready_for_verification", "blocked"] },
    "blocked_reason": { "type": "string", "minLength": 1 }
  },
  "if": {
    "properties": { "status": { "const": "ready_for_verification" } },
    "required": ["status"]
  },
  "then": {
    "required": [
      "findings_ref",
      "minimal_change_rung",
      "minimal_change_rationale",
      "changed_files",
      "commands",
      "test_first_evidence",
      "tests"
    ]
  },
  "else": {
    "required": ["blocked_reason"]
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change_type", "lines_added", "lines_removed"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "change_type": { "enum": ["added", "modified", "deleted"] },
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "command", "exit_code"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["pre_implementation", "post_implementation", "other"] },
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "output_ref": { "type": "string", "minLength": 1 },
        "output_summary": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["output_ref"], "not": { "required": ["output_summary"] } },
        { "required": ["output_summary"], "not": { "required": ["output_ref"] } }
      ]
    },
    "testEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_file", "test_name", "status"],
      "properties": {
        "test_file": { "type": "string", "minLength": 1 },
        "test_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["added", "modified"] }
      }
    },
    "dependencyChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "action", "justification"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "action": { "enum": ["added", "removed", "upgraded"] },
        "justification": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$comment": "Semantic rules not enforced here (deferred to the future Python validator): (1) commands[].id must be unique within this array; (2) test_first_evidence.pre_implementation_command_id and post_implementation_command_id must resolve to ids present in commands[], with stages 'pre_implementation' and 'post_implementation' respectively and exit_code!=0 then ==0; (3) findings_ref.finding_ids must resolve to ids that exist in the findings.json at findings_ref.path with classification 'found'. Rules (2) and (3) apply only when the corresponding field (test_first_evidence, findings_ref) is present in the instance -- a 'blocked' report that omits one of these fields (e.g. a zero-progress block reported before any findings were consulted or any command was run) is exempt from the corresponding rule, per the status-conditional 'required' fields below."
}
