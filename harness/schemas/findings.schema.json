{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticharness.local/schemas/findings.schema.json",
  "title": "Findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "created_at", "scope_ref", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "scope_ref": { "$ref": "#/$defs/artifactRef" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "obsidian_reads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/obsidianReadEntry" }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "evidence_tier"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "evidence_tier": {
          "enum": ["executable_code", "test_assertion", "runtime_config", "comment", "metadata"]
        },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "searchAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "query", "scope", "result"],
      "properties": {
        "method": { "enum": ["grep", "glob", "read", "other"] },
        "query": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    },
    "foundFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "classification", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "classification": { "const": "found" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceEntry" }
        }
      }
    },
    "notFoundFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "classification", "search_attempts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "classification": { "const": "not_found" },
        "search_attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/searchAttempt" }
        }
      }
    },
    "inferredFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "classification", "supporting_finding_ids", "reasoning"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "classification": { "const": "inferred" },
        "supporting_finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reasoning": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "oneOf": [
        { "$ref": "#/$defs/foundFinding" },
        { "$ref": "#/$defs/notFoundFinding" },
        { "$ref": "#/$defs/inferredFinding" }
      ]
    },
    "obsidianReadEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "query_or_note_path", "status"],
      "properties": {
        "tool": {
          "enum": ["mcp__obsidian__search_notes", "mcp__obsidian__read_note"]
        },
        "query_or_note_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!.*\\.\\.)(?![/\\\\])(?![A-Za-z]:)\\S.*$"
        },
        "status": {
          "enum": [
            "found", "no_matches", "invalid_query", "search_failed",
            "read", "not_found", "invalid_note_path", "read_failed",
            "connector_unavailable", "invalid_destination", "destination_unavailable"
          ]
        },
        "note_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!.*\\.\\.)(?![/\\\\])(?![A-Za-z]:)\\S.*\\.md$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$comment": "Semantic rules not enforced here (deferred to the future Python validator): (1) findings[].id must be unique within this array; (2) inferredFinding.supporting_finding_ids must resolve to ids of other entries in this same findings array whose classification is 'found'. obsidian_reads is an optional, bounded (<=20) array of strict entries echoing the Architect's own mcp__obsidian__* calls (harness/schemas/findings.schema.json's $defs.obsidianReadEntry): tool is restricted to exactly the two Obsidian read/search tools (no Jira tool, no wildcard, no write tool -- none exists); status is restricted to the real union of harness/orchestrator/obsidian_reader.py's READ_STATUSES and SEARCH_STATUSES (never an invented classification); query_or_note_path and note_path are bounded, reject '..', a leading '/' or '\\\\', and a drive-letter prefix (no absolute vault path, matching obsidian_reader.safe_note_target's own path-safety rejections), and note_path additionally requires a literal '.md' suffix (only Markdown notes are ever read); content_sha256, only meaningful for a read, is a strict lowercase 64-hex-digit sha256 hexdigest. No note body and no credential ever has a place to go in this shape."
}
