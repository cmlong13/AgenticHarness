{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticharness.local/schemas/scope.schema.json",
  "title": "Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "created_at",
    "source",
    "objective",
    "in_scope",
    "out_of_scope",
    "constraints",
    "acceptance_criteria",
    "task_graph",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "raw_prompt"],
      "properties": {
        "type": { "const": "prompt" },
        "raw_prompt": { "type": "string", "minLength": 1 }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "task_graph": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskGraphNode" }
    },
    "status": { "enum": ["approved", "refused"] },
    "refusal_reason": { "type": "string", "minLength": 1 }
  },
  "if": {
    "properties": { "status": { "const": "refused" } },
    "required": ["status"]
  },
  "then": {
    "required": ["refusal_reason"]
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "taskGraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "phase", "depends_on"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["research", "implementation", "verification"] },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$comment": "Semantic rule not enforced here (deferred to the future Python validator): task_graph[].depends_on entries must resolve to task_graph[].id values that exist elsewhere in this same array."
}
